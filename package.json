{
  "name": "miami-ride-companion",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual iPad kiosk app for rideshare drivers in Miami. Built with Claude AI — no framework, no build step, pure HTML/CSS/JS.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:lan": "wrangler dev --ip 0.0.0.0",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:index": "playwright test --grep @index",
    "test:games": "playwright test --grep @games",
    "test:editor": "playwright test --grep @editor",
    "test:backend": "playwright test --grep @backend",
    "test:weather": "playwright test --grep @weather",
    "test:content": "playwright test --grep @content",
    "test:phone": "playwright test --grep @phone",
    "test:rest": "playwright test --grep @rest",
    "test:smoke": "playwright test --grep @smoke",
    "test:negative": "playwright test --grep @negative",
    "test:i18n": "playwright test --grep @i18n",
    "test:units": "playwright test --grep @unit",
    "test:feedback": "playwright test --grep @feedback"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miamicompanionapp/miami-ride-companion.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "wrangler": "^4.95.0"
  }
}
