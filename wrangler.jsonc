{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miami-ride-companion",
  "main": "src/index.js",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "BIZCARD_STATS",
      "id": "f63a455973a0455e8625944523917b50"
    }
  ]
}
